<?xml version="1.0" encoding="utf-8"?>
<extension type="package" method="upgrade">
	<name>PKG_MDIMPORT</name>
	<packagename>mdimport</packagename>
	<author>Herman Peeren</author>
	<creationDate>2026-10</creationDate>
	<copyright>Copyright (C) Yepr, Herman Peeren. All rights reserved.</copyright>
	<license>GNU General Public License version 3 or later; see LICENSE.txt</license>
	<authorEmail>herman@yepr.nl</authorEmail>
	<authorUrl>https://yepr.nl</authorUrl>
	<version>0.1.1</version>
	<description>PKG_MDIMPORT_XML_DESCRIPTION</description>
	<packager>Herman Peeren</packager>
	<packagerurl>https://yepr.nl</packagerurl>
	<scriptfile>script.php</scriptfile>
	<blockChildUninstall>true</blockChildUninstall>

	<!-- The library first: the component needs it the moment it is opened. -->
	<files folder="packages">
		<file type="library" id="yepr_commonmark">lib_yepr_commonmark.zip</file>
		<file type="component" id="com_mdimport">com_mdimport.zip</file>
	</files>

	<languages folder="language">
		<language tag="en-GB">en-GB/pkg_mdimport.sys.ini</language>
	</languages>

	<updateservers>
		<server type="extension" priority="1" name="MD Import">https://raw.githubusercontent.com/HermanPeeren/md-import/main/updates.xml</server>
	</updateservers>
</extension>
