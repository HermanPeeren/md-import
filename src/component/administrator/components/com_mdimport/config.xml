<?xml version="1.0" encoding="utf-8"?>
<config>
	<fieldset name="target" label="COM_MDIMPORT_FIELDSET_TARGET" description="COM_MDIMPORT_FIELDSET_TARGET_DESC">
		<field
			name="parent_menu_item"
			type="menuitem"
			label="COM_MDIMPORT_FIELD_PARENT_MENU_ITEM_LABEL"
			description="COM_MDIMPORT_FIELD_PARENT_MENU_ITEM_DESC"
			client_id="0"
			default=""
			>
			<option value="">COM_MDIMPORT_OPTION_SELECT_MENU_ITEM</option>
		</field>

		<field
			name="section_menu_type"
			type="list"
			label="COM_MDIMPORT_FIELD_SECTION_MENU_TYPE_LABEL"
			description="COM_MDIMPORT_FIELD_SECTION_MENU_TYPE_DESC"
			default="heading"
			validate="options"
			>
			<option value="heading">COM_MDIMPORT_OPTION_SECTION_HEADING</option>
			<option value="category_list">COM_MDIMPORT_OPTION_SECTION_CATEGORY_LIST</option>
			<option value="category_blog">COM_MDIMPORT_OPTION_SECTION_CATEGORY_BLOG</option>
		</field>

		<field
			name="images_folder"
			type="folderlist"
			label="COM_MDIMPORT_FIELD_IMAGES_FOLDER_LABEL"
			description="COM_MDIMPORT_FIELD_IMAGES_FOLDER_DESC"
			directory="images"
			recursive="true"
			hide_default="true"
			default=""
			>
			<option value="">COM_MDIMPORT_OPTION_IMAGES_ROOT</option>
		</field>

		<field
			name="images_subfolder"
			type="text"
			label="COM_MDIMPORT_FIELD_IMAGES_SUBFOLDER_LABEL"
			description="COM_MDIMPORT_FIELD_IMAGES_SUBFOLDER_DESC"
			default="jdm-help"
			filter="path"
		/>

		<field
			name="parent_category"
			type="category"
			label="COM_MDIMPORT_FIELD_PARENT_CATEGORY_LABEL"
			description="COM_MDIMPORT_FIELD_PARENT_CATEGORY_DESC"
			extension="com_content"
			default="0"
			>
			<option value="0">COM_MDIMPORT_OPTION_CREATE_HELP_CATEGORY</option>
		</field>

		<field
			name="section_categories"
			type="radio"
			label="COM_MDIMPORT_FIELD_SECTION_CATEGORIES_LABEL"
			description="COM_MDIMPORT_FIELD_SECTION_CATEGORIES_DESC"
			layout="joomla.form.field.radio.switcher"
			default="1"
			filter="integer"
			>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>

		<field
			name="published"
			type="radio"
			label="COM_MDIMPORT_FIELD_PUBLISHED_LABEL"
			description="COM_MDIMPORT_FIELD_PUBLISHED_DESC"
			layout="joomla.form.field.radio.switcher"
			default="1"
			filter="integer"
			>
			<option value="0">JUNPUBLISHED</option>
			<option value="1">JPUBLISHED</option>
		</field>

		<field
			name="access"
			type="accesslevel"
			label="JFIELD_ACCESS_LABEL"
			default="1"
			filter="integer"
		/>

		<field
			name="language"
			type="contentlanguage"
			label="JFIELD_LANGUAGE_LABEL"
			default="*"
			>
			<option value="*">JALL</option>
		</field>

		<field
			name="on_existing"
			type="list"
			label="COM_MDIMPORT_FIELD_ON_EXISTING_LABEL"
			description="COM_MDIMPORT_FIELD_ON_EXISTING_DESC"
			default="update"
			validate="options"
			>
			<option value="update">COM_MDIMPORT_OPTION_UPDATE</option>
			<option value="skip">COM_MDIMPORT_OPTION_SKIP</option>
		</field>

		<field
			name="attribution"
			type="radio"
			label="COM_MDIMPORT_FIELD_ATTRIBUTION_LABEL"
			description="COM_MDIMPORT_FIELD_ATTRIBUTION_DESC"
			layout="joomla.form.field.radio.switcher"
			default="1"
			filter="integer"
			>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
	</fieldset>

	<fieldset name="source" label="COM_MDIMPORT_FIELDSET_SOURCE" description="COM_MDIMPORT_FIELDSET_SOURCE_DESC">
		<field
			name="source_owner"
			type="text"
			label="COM_MDIMPORT_FIELD_SOURCE_OWNER_LABEL"
			default="ceford"
			filter="cmd"
			required="true"
		/>
		<field
			name="source_repository"
			type="text"
			label="COM_MDIMPORT_FIELD_SOURCE_REPOSITORY_LABEL"
			description="COM_MDIMPORT_FIELD_SOURCE_REPOSITORY_DESC"
			default="cefjdemos-data-jdm-help-en"
			filter="cmd"
			required="true"
		/>
		<field
			name="source_branch"
			type="text"
			label="COM_MDIMPORT_FIELD_SOURCE_BRANCH_LABEL"
			default="2.0"
			filter="string"
			required="true"
		/>
	</fieldset>

	<fieldset name="links" label="COM_MDIMPORT_FIELDSET_LINKS" description="COM_MDIMPORT_FIELDSET_LINKS_DESC">
		<field
			name="user_guide_url"
			type="text"
			label="COM_MDIMPORT_FIELD_USER_GUIDE_URL_LABEL"
			description="COM_MDIMPORT_FIELD_USER_GUIDE_URL_DESC"
			default="/user-guide/"
			filter="string"
		/>
		<field
			name="help_pages_url"
			type="text"
			label="COM_MDIMPORT_FIELD_HELP_PAGES_URL_LABEL"
			description="COM_MDIMPORT_FIELD_HELP_PAGES_URL_DESC"
			default="/help-pages-references/"
			filter="string"
		/>
		<field
			name="source_url"
			type="url"
			label="COM_MDIMPORT_FIELD_SOURCE_URL_LABEL"
			description="COM_MDIMPORT_FIELD_SOURCE_URL_DESC"
			default="https://guide.joomla.org/help-pages-references/"
			filter="url"
			validate="url"
		/>
		<field
			name="manual_base"
			type="url"
			label="COM_MDIMPORT_FIELD_MANUAL_BASE_LABEL"
			description="COM_MDIMPORT_FIELD_MANUAL_BASE_DESC"
			default="https://jdocmanual.org/en/"
			filter="url"
			validate="url"
		/>
	</fieldset>

	<fieldset name="conversion" label="COM_MDIMPORT_FIELDSET_CONVERSION" description="COM_MDIMPORT_FIELDSET_CONVERSION_DESC">
		<field
			name="md_flavor"
			type="list"
			label="COM_MDIMPORT_FIELD_MD_FLAVOR_LABEL"
			description="COM_MDIMPORT_FIELD_MD_FLAVOR_DESC"
			default="gfm"
			validate="options"
			>
			<option value="gfm">COM_MDIMPORT_OPTION_FLAVOR_GFM</option>
			<option value="commonmark">COM_MDIMPORT_OPTION_FLAVOR_COMMONMARK</option>
		</field>
		<field
			name="md_html_input"
			type="list"
			label="COM_MDIMPORT_FIELD_MD_HTML_INPUT_LABEL"
			description="COM_MDIMPORT_FIELD_MD_HTML_INPUT_DESC"
			default="allow"
			validate="options"
			>
			<option value="allow">COM_MDIMPORT_OPTION_HTML_ALLOW</option>
			<option value="escape">COM_MDIMPORT_OPTION_HTML_ESCAPE</option>
			<option value="strip">COM_MDIMPORT_OPTION_HTML_STRIP</option>
		</field>
		<field
			name="md_allow_unsafe_links"
			type="radio"
			label="COM_MDIMPORT_FIELD_MD_ALLOW_UNSAFE_LINKS_LABEL"
			description="COM_MDIMPORT_FIELD_MD_ALLOW_UNSAFE_LINKS_DESC"
			layout="joomla.form.field.radio.switcher"
			default="0"
			filter="integer"
			>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
		<field
			name="md_max_nesting_level"
			type="number"
			label="COM_MDIMPORT_FIELD_MD_MAX_NESTING_LEVEL_LABEL"
			description="COM_MDIMPORT_FIELD_MD_MAX_NESTING_LEVEL_DESC"
			default="0"
			min="0"
			filter="integer"
		/>
		<field
			name="md_extensions"
			type="checkboxes"
			label="COM_MDIMPORT_FIELD_MD_EXTENSIONS_LABEL"
			description="COM_MDIMPORT_FIELD_MD_EXTENSIONS_DESC"
			multiple="true"
			>
			<option value="attributes">COM_MDIMPORT_EXTENSION_ATTRIBUTES</option>
			<option value="description_list">COM_MDIMPORT_EXTENSION_DESCRIPTION_LIST</option>
			<option value="external_link">COM_MDIMPORT_EXTENSION_EXTERNAL_LINK</option>
			<option value="footnote">COM_MDIMPORT_EXTENSION_FOOTNOTE</option>
			<option value="heading_permalink">COM_MDIMPORT_EXTENSION_HEADING_PERMALINK</option>
			<option value="smart_punct">COM_MDIMPORT_EXTENSION_SMART_PUNCT</option>
			<option value="table_of_contents">COM_MDIMPORT_EXTENSION_TABLE_OF_CONTENTS</option>
			<option value="autolink">COM_MDIMPORT_EXTENSION_AUTOLINK</option>
			<option value="strikethrough">COM_MDIMPORT_EXTENSION_STRIKETHROUGH</option>
			<option value="table">COM_MDIMPORT_EXTENSION_TABLE</option>
			<option value="task_list">COM_MDIMPORT_EXTENSION_TASK_LIST</option>
		</field>
	</fieldset>

	<fieldset name="permissions" label="JCONFIG_PERMISSIONS_LABEL" description="JCONFIG_PERMISSIONS_DESC">
		<field
			name="rules"
			type="rules"
			label="JCONFIG_PERMISSIONS_LABEL"
			validate="rules"
			filter="rules"
			component="com_mdimport"
			section="component"
		/>
	</fieldset>
</config>
